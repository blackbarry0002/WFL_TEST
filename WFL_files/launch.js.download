  window.QSI.global = {\n            enableJSSanitization: true,\n          }\n        );\n      })();\n      \n      WF_TAGGING.HELPERS.UTILS.loadScript({\n        src: filePath.concat(qtxFileName),\n        id: qtxScriptId,\n        callback: null\n      })\n      .then(() => {\n        let initSurvey = () => {\n          window.WF_TAGGING.surveyLinkHandler = () => {\n            try {\n              if (window.QSI && window.QSI.API) {\n                window.QSI.API.unload();\n                setTimeout(() => {\n                  window.QSI.API.load().then(window.QSI.API.run);\n                }, 250);\n              }\n            }\n            catch (error) {\n              if (window.location.hostname.indexOf("evetest") > 0)\n                console.warn("<TAGGING>: Error with Qualtrics - QSI.API - ", error);\n            }\n          };\n          window.WF_TAGGING_DATA.configured_qtx = true;\n        };\n        \n        window.addEventListener("qsi_js_loaded", initSurvey, false);\n      });\n    }\n  }\n  catch (error) {\n    if (window.location.hostname.indexOf("evetest") > 0)\n      console.warn("<TAGGING>: Error loading Qualtrics script - ", error);\n  }\n};\n\ntry {\n  if (window.WF_TAGGING && window.WF_TAGGING.HELPERS && window.WF_TAGGING.HELPERS.OT && window.WF_TAGGING.HELPERS.UTILS) {\n    window.WF_TAGGING.HELPERS.OT.isReady()\n    .then(() => {\n      window.WF_TAGGING.HELPERS.UTILS.delayExecution && window.WF_TAGGING.HELPERS.UTILS.delayExecution === true ? window.WF_TAGGING.HELPERS.UTILS.executeOnLoad(initQualtrics) : initQualtrics();\n    })\n    .catch ((error) => {\n      if (window.location.hostname.indexOf("evetest") > 0)\n        console.warn("<TAGGING>: Error initializing Qualtrics - \\n", error);\n    });\n  }\n}\ncatch (error) {\n  if (window.location.hostname.indexOf("evetest") > 0)\n    console.warn("<TAGGING>: Error initializing Qualtrics - \\n", error);\n}',language:"javascript"},timeout:2e3,delayNext:!0}]},{id:"RLb44bdc8ffce5482293