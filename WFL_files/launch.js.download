grationEnabled: false,\n            onBeforeEventSend: function (content) {\n              content.xdm.web.webPageDetails.URL = document.location.href;\n              content.xdm.web.webPageDetails.name = document.title;\n            }\n          });\n          window.WF_TAGGING_DATA.configured_aep = true;\n          WF_TAGGING.HELPERS.AEP.sendEvent(0, window.WF_TAGGING_DATA);  \n        };\n        \n        WF_TAGGING.HELPERS.UTILS.loadScript({\n          src: aepConfig.path.concat(aepFileName),\n          id: aepScriptId,\n          callback: configureAEP\n        });\n      }\n    }\n    else {\n      window.WF_TAGGING_DATA.configured_aep && window.WF_TAGGING_DATA.configured_aep === true && WF_TAGGING.HELPERS.AEP.sendEvent(0, window.WF_TAGGING_DATA);\n    }\n  }\n  catch (error) {\n    if (window.location.hostname.indexOf("evetest") > 0)\n      console.warn("<TAGGING>: Error loading AEP script - \\n", error);\n  }\n};\n\ntry {\n  if (window.WF_TAGGING && window.WF_TAGGING.HELPERS && window.WF_TAGGING.HELPERS.OT && window.WF_TAGGING.HELPERS.UTILS) {\n    window.WF_TAGGING.HELPERS.OT.isReady()\n    .then(() => {\n      window.WF_TAGGING.HELPERS.UTILS.delayExecution && window.WF_TAGGING.HELPERS.UTILS.delayExecution === true ? window.WF_TAGGING.HELPERS.UTILS.executeOnLoad(initAEP) : initAEP();\n    })\n    .catch ((error) => {\n      if (window.location.hostname.indexOf("evetest") > 0)\n        console.warn("<TAGGING>: Error initializing AEP - \\n", error);\n    });\n  }\n}\ncatch (error) {\n  if (window.location.hostname.indexOf("evetest") > 0)\n    console.warn("<TAGGING>: Error initializing AEP - \\n", error);\n}',language:"javascript"},timeout:2e3,delayNext:!0}]},{id:"RLc7fc41251a9e46d3a55fc2a6e4b1ea24",name:"002: capability | glassbox | global",events:[{modulePath:"core/src/lib/events/libraryLoaded.js",settings:{},ruleOrder:2}],conditions:[{modulePath:"core/src/lib/conditions/customCode.js",settings:{source:function(){try{return void 0!==window.WF_TAGGING_ENABLED&&window.WF_TAGGING_ENABLED}catch(e){window.location.hostname.indexOf("evetest")>0&&console.warn("<TAGGING>: Error checking WF_TAGGING_ENABLED switch status - \n",e)}}},timeout:2e3},{modulePath:"core/src/lib/conditions/customCode.js",settings:{source:function(){try{return window.WF_TAGGING&&window.WF_TAGGING.HELPERS.SWITCH&&!window.WF_TAGGING.HELPERS.SWITCH.gbx}catch(e){window.location.hostname.indexOf("evetest")>0&&console.warn("<TAGGING>: Error checking Glassbox switch status - \n",e)}}},timeout:2e3},{modulePath:"core/src/lib/conditions/customCode.js",settings:{source:function(){try{if(window.WF_TAGGING&&window.WF_TAGGING.HELPERS&&window.WF_TAGGING.HELPERS.OT)return window.WF_TAGGING.HELPERS.OT.isReady().then((()=>{if(window.WF_TAGGING.HELPERS.OT.isGroupConsented("C0001"))return!0})).catch((()=>!1))}catch(e){window.location.hostname.indexOf("evetest")>0&&console.warn("<TAGGING>: Error checking consent status for Glassbox - \n",e)}}},timeout:5e3}],actions:[{modulePath:"core/src/lib/actions/customCode.js",settings:{source:'let initGBX = () => {\n  try {    \n    let gbxFileName = "detector-dom.min.js",\n        gbxScriptId = "_cls_detector",\n        gbxConfig;\n\n    gbxConfig = WF_TAGGING.HELPERS.GBX.getV6Config();\n\n    if (WF_TAGGING.HELPERS.UTILS.hasValue(gbxConfig)) {\n      WF_TAGGING.HELPERS.UTILS.loadScript({\n        src: gbxConfig.path.concat(gbxFileName),\n        id: gbxScriptId,\n        callback: () => { window.WF_TAGGING_DATA.configured_gbx = true },\n        attrs: typeof gbxConfig.config !== "undefined" ? {\n          "data-clsconfig": "reportURI=".concat(gbxConfig.uri, gbxConfig.config)\n        } : {}\n      });\n    }\n  }\n  catch (error) {\n    if (window.location.hostname.indexOf("evetest") > 0)\n      console.warn("<TAGGING>: Error loading Glassbox script - \\n", error);\n  } \n};\n\ntry {\n  if (window.WF_TAGGING && window.WF_TAGGING.HELPERS && window.WF_TAGGING.HELPERS.OT && window.WF_TAGGING.HELPERS.UTILS) {\n    window.WF_TAGGING.HELPERS.OT.isReady()\n    .then(() => {\n      window.WF_TAGGING.HELPERS.UTILS.delayExecution && window.WF_TAGGING.HELPERS.UTILS.delayExecution === true ? window.WF_TAGGING.HELPERS.UTILS.executeOnLoad(initGBX) : initGBX();\n    })\n    .catch ((error) => {\n      if (window.location.hostname.indexOf("evetest") > 0)\n        console.warn("<TAGGING>: Error initializing Glassbox - \\n", error);\n    });\n  }\n}\ncatch (error) {\n  if (window.location.hostname.indexOf("evetest") > 0)\n    console.warn("<TAGGING>: Error initializing Glassbox - \\n", error);\n}',language:"javascript"},timeout:2e3,delayNext:!0}]},{id:"RLdc422504fd0e41db9f3b597c846d8851",name:"001: core | framework | global",events:[{modulePath:"core/src/lib/events/libraryLoaded.js",settings:{},ruleOrder:1}],conditions:[],actions:[{modulePath:"core/src/lib/actions/customCode.js",settings:{global:!0,
source:'/*\n * Wells Fargo\n * Tagging Framework (WF_TAGGING) module for managing tagging and tracking across Wells Fargo properties.\n * @version 1.0.0\n * @lastUpdated 2026-05-18\n */\n\nwindow.WF_TAGGING = window.WF_TAGGING || (function(){\n  "use strict";\n\n  let TAGGING = {\n    eventQueue: [],\n    pixelsLoaded: [],\n    isProcessingQueue: false,\n    delayExecution: true,\n    killswitch: {\n      gbx: false,\n      aep: false,\n      gtag: false,\n      survey: false\n    },\n    DEFAULT_BASE_PATH: "https://c1.wfinterface.com/mt/",\n    tagURL: {},\n    otHelper: {\n      config: {\n        max_retries: 80,\n        retry_interval: 125,\n        timeout: 10000,\n        purpose_groups: {\n          C0001: "Strictly Necessary",\n          C0002: "Performance & Analytics",\n          C0003: "Functional",\n          C0004: "Marketing & Advertising"\n        }\n      },\n      isOneTrustAvailable: () => {\n        return typeof window !== "undefined" && \n               typeof window.Optanon !== "undefined" &&\n               typeof window.OnetrustActiveGroups !== "undefined";\n      },\n      getActiveGroups: () => {\n        try {\n          return TAGGING.otHelper.isOneTrustAvailable() ? (window.OnetrustActiveGroups || "") : "";\n        }\n        catch (error) {\n          logger("<TAGGING>: Error in getActiveGroups() - ", error);\n          return "";\n        }\n      },\n      parseGroupsString: (groupsStr) => {\n        try {\n          return groupsStr ? groupsStr.split(",").map(g => g.trim()) : [];\n        }\n        catch (error) {\n          logger("<TAGGING>: Error in parseGroupsString() - ", error);\n          return [];\n        }\n      },\n      getActiveGroupsAsync: (timeout) => {\n        try {\n          if (timeout !== undefined && (typeof timeout !== "number" || timeout < 0)) {\n            timeout = TAGGING.otHelper.config.timeout;\n          }\n        \n          return new Promise((resolve, reject) => {\n            const startTime = Date.now();\n            let retries = 0;\n\n            const checkOneTrust = () => {\n              if (Date.now() - startTime > timeout) {\n                logger("<TAGGING>: OneTrust consent check timeout!");\n                return reject(new Error("<TAGGING>: OneTrust consent check timeout!")).catch(() => {});\n              }\n              if (TAGGING.otHelper.isOneTrustAvailable()) {\n                const groups = window.OnetrustActiveGroups || "";\n                return resolve(groups);\n              }\n              retries++;\n              if (retries <= TAGGING.otHelper.config.max_retries) {\n                setTimeout(checkOneTrust, TAGGING.otHelper.config.retry_interval);\n              } else {\n                logger("<TAGGING>: OneTrust library not found after maximum retries!");\n                return reject(new Error("<TAGGING>: OneTrust library not found after maximum retries!")).catch(() => {});\n              }\n            };\n            checkOneTrust();\n          });\n        }\n        catch (error) {\n          logger("<TAGGING>: Error in getActiveGroupsAsync() - ", error);\n          return Promise.resolve("");\n        }\n      },\n      isGroupConsented: (groupId) => {\n        try {\n          if (typeof groupId !== "string" || !groupId.trim()) {\n            logger("<TAGGING>: Consent group ID must be a non-empty string!");\n            return false;\n          }\n          const activeGroups = TAGGING.otHelper.getActiveGroups();\n          if (!activeGroups) return false;\n        \n          const groupsArray = TAGGING.otHelper.parseGroupsString(activeGroups);\n          return groupsArray.includes(groupId);\n        }\n        catch (error) {\n          logger("<TAGGING>: Error in isGroupConsented() - ", error);\n          return false;\n        }\n      },\n      isGroupConsentedAsync: (groupId, timeout) => {\n        try {\n          if (typeof groupId !== "string" || !groupId.trim()) {\n            logger("<TAGGING>: Consent group ID must be a non-empty string!");\n            return Promise.resolve(false);\n          }\n          if (timeout !== undefined && (typeof timeout !== "number" || timeout < 0)) {\n            timeout = TAGGING.otHelper.config.timeout;\n          }\n          return TAGGING.otHelper.getActiveGroupsAsync(timeout)\n          .then(activeGroups => {\n            const groupsArray = TAGGING.otHelper.parseGroupsString(activeGroups);\n            return groupsArray.includes(groupId);\n          })\n          .catch(() => false);\n        }\n        catch (error) {\n          logger("<TAGGING>: Error in isGroupConsentedAsync() - ", error);\n          return Promise.resolve(false);\n        }\n      },\n      areGroupsConsented: (groupIds) => {\n        try {\n          if (!Array.isArray(groupIds)) {\n            logger("<TAGGING>: Consent group IDs must be an array of strings!");\n            return {};\n          }\n          const activeGroups = TAGGING.otHelper.getActiveGroups();\n          const groupsArray = TAGGING.otHelper.parseGroupsString(activeGroups);\n        \n          const result = {};\n          groupIds.forEach(groupId => {\n            result[groupId] = groupsArray.includes(groupId);\n          });\n          return result;\n        }\n        catch (error) {\n          logger("<TAGGING>: Error in areGroupsConsented() - ", error);\n          return {};\n        }\n      },\n      areGroupsConsentedAsync: (groupIds, timeout) => {\n        try {\n          if (!Array.isArray(groupIds)) {\n            logger("<TAGGING>: Consent group IDs must be an array of strings!");\n            return Promise.resolve({});\n          }\n          if (timeout !== undefined && (typeof timeout !== "number" || timeout < 0)) {\n            timeout = TAGGING.otHelper.config.timeout;\n          }\n          return TAGGING.otHelper.getActiveGroupsAsync(timeout)\n          .then(activeGroups => {\n            const groupsArray = TAGGING.otHelper.parseGroupsString(activeGroups);\n            const result = {};\n            groupIds.forEach(groupId => {\n              result[groupId] = groupsArray.includes(groupId);\n            });\n            return result;\n          })\n          .catch(() => {\n            const result = {};\n            groupIds.forEach(groupId => {\n              result[groupId] = false;\n            });\n            return result;\n          });\n        }\n        catch (error) {\n          logger("<TAGGING>: Error in areGroupsConsentedAsync() - ", error);\n          Promise.resolve({});\n        }\n      },\n      onConsentChange: (callback) => {\n        try {\n          if (typeof callback !== "function") {\n            logger("<TAGGING>: OneTrust consent change callback must be a function!");\n            return () => {};\n          }\n\n          const handler = () => {\n            const activeGroups = TAGGING.otHelper.getActiveGroups();\n            callback(activeGroups);\n          };\n\n          if (typeof window !== "undefined") {\n            window.addEventListener("OptanonConsentChanged", handler);\n          }\n\n          return () => {\n            if (typeof window !== "undefined") {\n              window.removeEventListener("OptanonConsentChanged", handler);\n            }\n          };\n        }\n        catch (error) {\n          logger("<TAGGING>: Error in onConsentChange() - ", error);\n        }\n      },\n      getFullConsentStatus: () => {\n        try {\n          if (!TAGGING.otHelper.isOneTrustAvailable()) {\n            return {};\n          }\n\n          return {\n            activeGroups: window.OnetrustActiveGroups || "",\n            timestamp: Date.now(),\n            availableGroups: TAGGING.otHelper.config.purpose_groups\n          };\n        }\n        catch (error) {\n          logger("<TAGGING>: Error in getFullConsentStatus() - ", error);\n          return {};\n        }\n      },\n      waitForOneTrustReady: (timeout) => {\n        try {\n          if (timeout !== undefined && (typeof timeout !== "number" || timeout < 0)) {\n            timeout = TAGGING.otHelper.config.timeout;\n          }\n        \n          return new Promise((resolve, reject) => {\n            if (TAGGING.otHelper.isOneTrustAvailable()) {\n              return resolve();\n            }\n\n            const startTime = Date.now();\n            const checkReady = () => {\n              if (TAGGING.otHelper.isOneTrustAvailable()) {\n                return resolve();\n              }\n              if (Date.now() - startTime > timeout) {\n                logger("<TAGGING>: OneTrust library did not load within timeout!");\n                return reject(new Error("<TAGGING>: OneTrust library did not load within timeout!")).catch(() => {});\n              }\n              setTimeout(checkReady, TAGGING.otHelper.config.retry_interval);\n            };\n            checkReady();\n          });\n        }\n        catch (error) {\n          logger("<TAGGING>: Error in waitForOneTrustReady() - ", error);\n        }\n      }\n    },\n    trackView: (eventData) => {\n      try {\n        logger("<TAGGING>: Track view event received - \\n", eventData);\n        _satellite && _satellite.track("WF_TAGGING_VIEW", eventData);\n      }\n      catch (error) {\n        logger("<TAGGING>: Error in trackView() - ", error);\n      }\n    },\n    trackEvent: (eventData) => {\n      try {\n        logger("<TAGGING>: Track event received - \\n", eventData);\n        _satellite && _satellite.track("WF_TAGGING_EVENT", eventData);\n      }\n      catch (error) {\n        logger("<TAGGING>: Error in trackEvent() - ", error);\n      }\n    },\n    track: (eventData) => {\n      try {\n        if (!eventData || !eventData.type) {\n          logger("<TAGGING>: Missing or incomplete data in WF_TAGGING.track() call!")\n          return;\n        }\n        \n        if (!TAGGING.otHelper.isOneTrustAvailable()) {\n          TAGGING.eventQueue.push(eventData);\n        }\n        else {\n          if (TAGGING.eventQueue.length === 0) {\n            const eventType = eventData.type.toLowerCase();\n            if (eventType === "view") {\n              TAGGING.trackView(eventData);\n            } else if (eventType === "interaction") {\n              TAGGING.trackEvent(eventData);\n            }\n          } else {\n            TAGGING.eventQueue.push(eventData);\n          }\n        }\n        \n        if (TAGGING.eventQueue.length > 0 && !TAGGING.isProcessingQueue) {\n          TAGGING.isProcessingQueue = true;\n          setTimeout(TAGGING.processEvents, 50);\n        }\n      }\n      catch (error) {\n        logger("<TAGGING>: Error in track() - ", error);\n      }\n    },\n    executeWithConsentCheck: (groupId, callback, timeout) => {\n      try {\n        if (timeout !== undefined && (typeof timeout !== "number" || timeout < 0)) {\n          timeout = TAGGING.otHelper.config.timeout;\n        }\n        if (typeof groupId !== "string" || !groupId.trim()) {\n          logger("<TAGGING>: Consent group ID must be a non-empty string!");\n          return Promise.reject(new Error("<TAGGING>: Consent group ID must be a non-empty string!")).catch(() => {});\n        }\n        if (typeof callback !== "function") {\n          logger("<TAGGING>: Consent check callback must be a function!");\n          return Promise.reject(new Error("<TAGGING>: Consent check callback must be a function!")).catch(() => {});\n        }\n\n        if (!TAGGING.otHelper.isOneTrustAvailable()) {\n          return TAGGING.otHelper.waitForOneTrustReady(timeout)\n          .then(() => {\n            const isConsented = TAGGING.otHelper.isGroupConsented(groupId);\n            if (!isConsented) {\n              logger(`<TAGGING>: Consent not granted for group - ${groupId}`);\n              return Promise.reject(new Error(`<TAGGING>: Consent not granted for group - ${groupId}`)).catch(() => {});\n            }\n            return Promise.resolve(callback());\n          })\n          .catch(error => {\n            logger(`<TAGGING>: Consent check failed for group ${groupId} - `, error);\n            return Promise.reject(new Error(error)).catch(() => {});\n          });\n        }\n\n        const isConsented = TAGGING.otHelper.isGroupConsented(groupId);\n        if (!isConsented) {\n          logger(`<TAGGING>: Consent not granted for group - ${groupId}`);\n          return Promise.reject(new Error(`<TAGGING>: Consent not granted for group - ${groupId}`)).catch(() => {});\n        }\n\n        try {\n          const result = callback();\n          return Promise.resolve(result);\n        }\n        catch (error) {\n          logger(`<TAGGING>: Error executing callback for group ${groupId} - \\n`, error);\n          return Promise.reject(new Error(error)).catch(() => {});\n        }\n      }\n      catch (error) {\n        logger("<TAGGING>: Error in executewithConsent() - ", error);\n      }\n    },\n    processEvents: (timeout) => {\n      try {\n        if (timeout !== undefined && (typeof timeout !== "number" || timeout < 0)) {\n          timeout = TAGGING.otHelper.config.timeout;\n        }\n\n        return TAGGING.otHelper.waitForOneTrustReady(timeout)\n        .then(() => {\n          const eventCount = TAGGING.eventQueue.length;\n          while (TAGGING.eventQueue.length > 0) {\n            const event = TAGGING.eventQueue.shift();\n            const eventType = event.type.toLowerCase();\n            \n            if (eventType === "view") {\n              TAGGING.trackView(event);\n            } else if (eventType === "interaction") {\n              TAGGING.trackEvent(event);\n            }\n          }\n          TAGGING.isProcessingQueue = false;\n          logger(`<TAGGING>: Processed ${eventCount} queued events.`);\n          return Promise.resolve();\n        })\n        .catch(error => {\n          TAGGING.isProcessingQueue = false;\n          logger("<TAGGING>: Failed to process event queue - \\n", error);\n          return Promise.reject(new Error(error)).catch(() => {});\n        });\n      }\n      catch (error) {\n        logger("<TAGGING>: Error in processEvents() - ", error);\n      }\n    },\n    utils: {\n      triggerViewEvent: () => {\n        try {\n          TAGGING.track({\n            type: "view",\n            action: "pageview",\n            category: "navigation",\n            data: WF_TAGGING_DATA\n          });\n        }\n        catch (error) {\n          logger("<TAGGING>: Error in triggerViewEvent() - ", error);\n        }\n      },\n      optimizeTags: () => {\n        try {\n          document.readyState === "complete" ? TAGGING.utils.triggerViewEvent() : window.addEventListener("load", TAGGING.utils.triggerViewEvent);\n        }\n        catch (error) {\n          logger("<TAGGING>: Error in optimizeTags() - ", error);\n        }\n      },\n      executeOnLoad: (callback) => {\n        try {\n          if (typeof callback !== "function")\n            return;\n          document.readyState === "complete" ? callback() : window.addEventListener("load", callback);\n        }\n        catch (error) {\n          logger("<TAGGING>: Error in executeOnLoad() - ", error);\n        }\n      },\n      getBasePath: () => {\n        try {\n          if (!WF_TAGGING_DATA || !WF_TAGGING_DATA.tagging_js_path) {\n            logger("<TAGGING>: Property missing - WF_TAGGING_DATA.tagging_js_path is not defined.");\n            return "";\n          }\n        \n          const taggingPath = WF_TAGGING_DATA.tagging_js_path.replace("/launch.js", "");\n          const lastSlashIndex = taggingPath.lastIndexOf("/");\n          if (lastSlashIndex === -1) {\n            logger("<TAGGING>: Invalid path or format - WF_TAGGING_DATA.tagging_js_path");\n            return "";\n          }\n          return taggingPath.slice(0, lastSlashIndex + 1);\n        }\n        catch (error) {\n          logger("<TAGGING>: Error in getBasePath() - ", error);\n          return "";\n        }\n      },\n      getTimestamp: (date = new Date()) => {\n        try {\n          const pad = (n) => n.toString().padStart(2, "0");\n          return [date.getFullYear().toString(), pad(date.getMonth() + 1), pad(date.getDate()), pad(date.getHours()), pad(date.getMinutes()), pad(date.getSeconds())].join("") || "";\n        }\n        catch (error) {\n          logger("<TAGGING>: Error in getTimestamp() - ", error);\n          return "";\n        }\n      },\n      logger: () => {\n        try {\n          if (typeof console === "undefined" || typeof console.warn === "undefined" || ["STAGING", "PRODUCTION", "PROD"].includes(WF_TAGGING_DATA.environment.toUpperCase())) {\n            return () => {};\n          }\n          return console.warn.bind(console);\n        }\n        catch (error) {\n          return () => {};\n        }\n      },\n      hasValue: (value) => {\n        try {\n          return typeof value !== "undefined" && value !== null && value !== "";\n        }\n        catch (error) {\n          logger("<TAGGING>: Error in hasValue() - ", error);\n          return false;\n        }\n      },\n      setCookie: (name, val, exp, dmn) => {\n        try {\n          if(!name || !val || !exp) return;\n          let date = new Date();\n          date.setTime(date.getTime() + (exp * 24 * 60 * 60 * 1000));\n          let expires = "expires=" + date.toUTCString();\n          let domain = (!dmn ? ";domain=.wellsfargo.com" : (";domain=" + dmn));\n          document.cookie = name + "=" + val + ";" + expires + domain + ";path=/; secure";\n        }\n        catch(error){\n          logger("<TAGGING>: <setCookie> failed - ", error);\n        }\n      },\n      getCookie: (name) => {\n        try {\n          if(!name) return;\n          let matches = document.cookie.match(new RegExp("(?:^|; )" + name.replace(/([\\.$?*|{}\\(\\)\\[\\]\\\\\\/\\+^])/g, \'\\\\$1\') + "=([^;]*)"));\n          return matches ? decodeURIComponent(matches[1]) : undefined;\n        }\n        catch(e